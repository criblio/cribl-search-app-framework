# @criblio packages publish to GitHub Packages, not npmjs. They are
# public, but GitHub Packages requires authentication even for public
# reads, so a token is always needed.
#
# The auth line is env-substituted and is NOT a secret in this file — npm
# expands ${NODE_AUTH_TOKEN} at read time, so committing it is safe and is
# what lets `npm ci` work in CI without a bespoke setup step.
#
#   CI:     NODE_AUTH_TOKEN=${{ github.token }} (read:packages is implicit)
#   local:  export NODE_AUTH_TOKEN=$(gh auth token)
#
# Without this file npm looks for @criblio on npmjs and fails with a
# confusing 404 ("Note that you can also install from a tarball…") rather
# than an auth error. With the file but no token it fails E401.
@criblio:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
