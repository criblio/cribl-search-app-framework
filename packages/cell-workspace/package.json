{
  "name": "@criblio/cell-workspace",
  "version": "0.1.3",
  "type": "module",
  "description": "Source-code workspace for cells (server-side agents on celld): lazy tarball checkout into Durable Object SQLite plus the read-only code tools over it. Worker-native — no filesystem, no subprocess.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@criblio/agent-protocol": "^0.4.0"
  },
  "peerDependencies": {
    "@criblio/app-utils": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "@criblio/app-utils": "^0.8.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/criblio/cribl-search-app-framework.git",
    "directory": "packages/cell-workspace"
  },
  "files": [
    "dist",
    "src"
  ]
}
