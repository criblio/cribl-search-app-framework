{
  "name": "@criblio/agent-protocol",
  "version": "0.1.1",
  "type": "module",
  "description": "Wire protocol between a cell (server-side agent harness on celld) and its app UI: loop events, server frames, session statuses. Isomorphic \u2014 no runtime dependencies, safe in workers and browsers.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/criblio/cribl-search-app-framework.git",
    "directory": "packages/agent-protocol"
  },
  "files": [
    "dist",
    "src"
  ]
}
