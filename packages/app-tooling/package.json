{
  "name": "@criblio/app-tooling",
  "version": "0.4.2",
  "type": "module",
  "description": "Deterministic package, deployment, release, and security tooling for Cribl Apps",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./pack": {
      "types": "./src/pack.d.ts",
      "default": "./src/pack.mjs"
    },
    "./inspect": {
      "types": "./src/inspect.d.ts",
      "default": "./src/inspect.mjs"
    },
    "./proxies": {
      "types": "./src/proxies.d.ts",
      "default": "./src/proxies.mjs"
    },
    "./deploy": {
      "types": "./src/deploy.d.ts",
      "default": "./src/deploy.mjs"
    },
    "./release-evidence": {
      "types": "./src/release-evidence.d.ts",
      "default": "./src/release-evidence.mjs"
    },
    "./security": {
      "types": "./src/security.d.ts",
      "default": "./src/security.mjs"
    },
    "./playwright": {
      "types": "./src/playwright.d.ts",
      "default": "./src/playwright.mjs"
    }
  },
  "bin": {
    "cribl-app-package": "./bin/package.mjs",
    "cribl-app-deploy": "./bin/deploy.mjs",
    "cribl-app-inspect": "./bin/inspect.mjs",
    "cribl-app-release-evidence": "./bin/release-evidence.mjs",
    "cribl-app-security": "./bin/security.mjs"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p test-types/tsconfig.json",
    "audit": "npm audit --audit-level=low"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/criblio/cribl-search-app-framework.git",
    "directory": "packages/app-tooling"
  }
}
